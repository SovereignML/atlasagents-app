{
  "name": "sovereign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "lsof -ti:3000 | xargs kill 2>/dev/null || true",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "next start",
    "start:standalone": "node --env-file=.env .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bootstrap:pg": "bash scripts/bootstrap-pg.sh",
    "bootstrap:host": "tsx scripts/bootstrap-shared-host.ts",
    "db:push": "node --env-file=.env node_modules/drizzle-kit/bin.cjs push",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "make-admin": "node --env-file=.env --import tsx scripts/make-admin.ts",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "test:vps-router": "tsx scripts/test-vps-router.ts",
    "test:white-label": "tsx scripts/test-white-label.ts",
    "test:uptime-kuma": "node --env-file=.env --import tsx scripts/test-uptime-kuma.ts",
    "test:openrouter-key-mint": "node --env-file=.env --import tsx scripts/test-openrouter-key-mint.ts",
    "test:openrouter-usage-sync": "node --env-file=.env --import tsx scripts/test-openrouter-usage-sync.ts",
    "test:billing-hardening": "node --env-file=.env --import tsx scripts/test-billing-hardening.ts",
    "openrouter:backfill-usage": "node --env-file=.env --import tsx scripts/backfill-openrouter-usage.ts",
    "backfill:personal-teams": "node --env-file=.env --import tsx scripts/backfill-personal-teams.ts",
    "wallets:migrate": "node --env-file=.env --import tsx scripts/migrate-wallets-to-credits.ts",
    "whitelabel:backfill-hostnames": "node --env-file=.env --import tsx scripts/backfill-custom-hostnames.ts",
    "byos:sweep-orphans": "node --env-file=.env --import tsx scripts/sweep-orphan-byos-instances.ts",
    "seed:agent-events": "node --env-file=.env --import tsx scripts/seed-agent-events.ts",
    "support:backfill-chatwoot": "node --env-file=.env --import tsx scripts/backfill-chatwoot-messages.ts",
    "providers:enable-akamai": "node --env-file=.env --import tsx scripts/enable-akamai-default.ts",
    "providers:remove-ovh": "node --env-file=.env --import tsx scripts/remove-ovh-provider.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@base-ui/react": "^1.9.0",
    "@linode/api-v4": "^0.158.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@sentry/nextjs": "^10.56.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.1.0",
    "google-auth-library": "^10.7.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "node-ssh": "^13.2.1",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.7",
    "posthog-node": "^5.55.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "resend": "^6.9.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "stripe": "^17.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.8",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^4.1.8"
  }
}
