; systemd unit for bare-metal VPS deploy (alternative to pm2).
;
; Install:
;   sudo cp deploy/redesigned-giggle.service /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now redesigned-giggle
;   journalctl -u redesigned-giggle -f
;
; Assumes:
;   - App checked out at /opt/redesigned-giggle (adjust WorkingDirectory below)
;   - `npm ci && npm run build` already run there
;   - The DB schema is synced automatically on start by
;     scripts/deploy-entrypoint.sh (drizzle-kit push), so no manual db:push
;     step is needed after a deploy.
;   - /etc/redesigned-giggle.env contains DATABASE_URL, AUTH_SECRET,
;     NEXTAUTH_URL, etc. (chmod 600, owned by the app user)

[Unit]
Description=redesigned-giggle (Next.js standalone)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=nextjs
Group=nextjs
WorkingDirectory=/opt/redesigned-giggle
EnvironmentFile=/etc/redesigned-giggle.env
Environment=NODE_ENV=production
; Loopback only: the reverse proxy is the public listener (see deploy/Caddyfile).
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
; Syncs the DB schema (drizzle-kit push), then execs the standalone server
; (same pid, so systemd keeps tracking it as the main process).
ExecStart=/usr/bin/env bash scripts/deploy-entrypoint.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
LimitNOFILE=65536

; Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/redesigned-giggle /var/log/redesigned-giggle

[Install]
WantedBy=multi-user.target
