# Caddy reverse proxy for the SovereignML dashboard, fronting the Next.js
# standalone server on 127.0.0.1:3000.
#
# This terminates TLS for the canonical dashboard host only.
#
# White-label per-team CUSTOM domains are NO LONGER handled here. They are
# served via Cloudflare for SaaS (Custom Hostnames): Cloudflare terminates TLS
# at its edge and proxies to our fallback origin. See src/lib/cloudflare-saas.ts
# and deploy/README.md. The old on-demand-TLS catch-all + the
# /api/internal/tls-authorize ask endpoint have been removed.
#
# Install:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   # edit the email + canonical host below, then:
#   sudo systemctl reload caddy   # or: caddy reload --config /etc/caddy/Caddyfile
#
# Prereqs: the Next app binds to 127.0.0.1:3000 (loopback).

{
	# ACME contact for Let's Encrypt. REQUIRED — set to a real mailbox.
	email admin@example.com
}

# ── Canonical dashboard host ────────────────────────────────────────────
# REPLACE app.example.com with your real dashboard host. Gets a normal
# managed certificate.
app.example.com {
	# The internal API namespace is for loopback callers only — never expose it.
	@internal path /api/internal/*
	respond @internal 403

	reverse_proxy 127.0.0.1:3000
}
