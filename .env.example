# ════════════════════════════════════════════════════════════════════
#  SovereignML — environment configuration   (THIS FILE: template — copy to .env)
# ════════════════════════════════════════════════════════════════════
#  ⚠  KEEP `.env` AND `.env.example` IN SYNC.
#
#  These two files MUST have the SAME keys, in the SAME order, under the
#  SAME section headers, with the SAME comments. The ONLY thing that may
#  differ is the VALUES:
#
#     • .env          → real secrets & live values  (git-ignored — NEVER commit)
#     • .env.example  → empty placeholders / safe non-secret defaults
#
#  When you ADD, RENAME, or REMOVE a variable, do it in BOTH files, in the
#  same place. Change structure here → mirror it there (and vice-versa).
#
#  Order: core app → auth → billing → integrations → Bot Factory
#  (LLM / VPS / runtimes) → infra → advanced/dev-only.
#
#  Vars shown COMMENTED-OUT below are optional and fall back to a built-in
#  default in code — uncomment only to override. Leaving them as bare `KEY=`
#  would override the default with an empty string, so keep them commented.
# ════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────
# Postgres connection string used by Prisma (src/db/index.ts).
# Prod tip: append &connection_limit=10&pool_timeout=30
DATABASE_URL="postgresql://sovereignml:password@localhost:5432/sovereignml?schema=public"
# POSTGRES_* are consumed by Docker Compose to initialize the DB container;
# keep them consistent with the user/password/db in DATABASE_URL above.
POSTGRES_USER=sovereignml
POSTGRES_PASSWORD=password
POSTGRES_DB=sovereignml

# ─── App / Server ────────────────────────────────────────────────
# Public base URL of this app — used for OAuth callbacks, emails, etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000             # port the Next.js server listens on
HOSTNAME=127.0.0.1    # interface the server binds to

# ─── White-label custom dashboard domains (optional) ─────────────
# CNAME target shown to teams connecting a custom dashboard domain.
# Defaults to the NEXT_PUBLIC_APP_URL host. See deploy/README.md §10.
# WHITELABEL_CNAME_TARGET="cname.sovereignml.com"
# Extra shared-secret header required on the Caddy on-demand-TLS ask
# endpoint (/api/internal/tls-authorize). Optional; loopback-only by default.
# TLS_AUTHORIZE_SECRET=""

# ─── NextAuth ────────────────────────────────────────────────────
# Canonical URL NextAuth uses to build OAuth callback URLs.
NEXTAUTH_URL="http://localhost:3000"
# Session/JWT encryption secret. Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET and AUTH_SECRET are read interchangeably — keep them equal.
NEXTAUTH_SECRET=""
AUTH_SECRET=""
AUTH_TRUST_HOST=true  # trust the host header (needed behind a proxy)

# ─── Google OAuth + Drive backups ────────────────────────────────
# Same client powers Google sign-in AND per-user Google Drive backups
# (scope drive.file). In the Google Cloud console add the Drive redirect URI
# as an Authorized redirect URI and add the `.../auth/drive.file` scope.
# (NextAuth also accepts AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET as aliases.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to <NEXT_PUBLIC_APP_URL>/api/integrations/drive/callback
GOOGLE_DRIVE_REDIRECT_URI=""

# ─── X / Twitter OAuth (optional) ────────────────────────────────
# OAuth 2.0 client from https://developer.x.com/en/portal/dashboard
# (Aliases: AUTH_TWITTER_ID / AUTH_TWITTER_SECRET.)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# ─── Apple OAuth (optional) ──────────────────────────────────────
# Service ID + a JWT client secret. Generate the secret JWT with
# `npx auth add apple` or per Apple's "Creating a Client Secret" docs.
# (Aliases: AUTH_APPLE_ID / AUTH_APPLE_SECRET.)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ─── Stripe ──────────────────────────────────────────────────────
# Secret key + webhook signing secret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs per plan tier — names MUST match src/configs/plans.ts
# (FREE, BUILDER, OPERATOR, SCALE, ENTERPRISE, BYOS).
STRIPE_PRICE_FREE_MONTHLY=""
STRIPE_PRICE_FREE_YEARLY=""
STRIPE_PRICE_BUILDER_MONTHLY=""
STRIPE_PRICE_BUILDER_YEARLY=""
STRIPE_PRICE_OPERATOR_MONTHLY=""
STRIPE_PRICE_OPERATOR_YEARLY=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_YEARLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_YEARLY=""
STRIPE_PRICE_BYOS_MONTHLY=""
STRIPE_PRICE_BYOS_YEARLY=""

# ─── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@sovereignml.com"

# ─── Notifications: Telegram bot ─────────────────────────────────
# A DEDICATED bot for sending users their notifications. This is NOT a
# user's deployed bot (those route at /tg/[botToken]). Create one via
# @BotFather, then register the webhook once:
#   curl "https://api.telegram.org/bot<token>/setWebhook" \
#     -d url=<NEXT_PUBLIC_APP_URL>/api/notifications/telegram/webhook \
#     -d secret_token=<NOTIFY_TELEGRAM_WEBHOOK_SECRET>
# Discord/Slack need no env — users paste per-account incoming webhook URLs.
NOTIFY_TELEGRAM_BOT_TOKEN=""            # from @BotFather
NOTIFY_TELEGRAM_BOT_USERNAME=""         # bot username for the t.me deep link, no @
NOTIFY_TELEGRAM_WEBHOOK_SECRET=""       # verifies X-Telegram-Bot-Api-Secret-Token

# ─── Chatwoot Support ────────────────────────────────────────────
# Live-chat widget + in-app support tickets, backed by your Chatwoot
# instance. The two NEXT_PUBLIC_ vars power the embedded chat bubble;
# the rest are server-only and used to create tickets via the API.
#
# Tickets are created in CHATWOOT_INBOX_ID — point it at the inbox the
# support@sovereignml.com team monitors. If the API vars are unset (or a
# call fails) the ticket form falls back to emailing support@ via Resend.
NEXT_PUBLIC_CHATWOOT_BASE_URL=""  # e.g. https://chat.sovereignml.com (no trailing slash)
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=""    # website channel token (public, drives the widget)
CHATWOOT_HMAC_TOKEN=""                   # optional — enables widget identity verification
CHATWOOT_API_ACCESS_TOKEN=""            # agent/bot API access token (server only)
CHATWOOT_ACCOUNT_ID=""                   # numeric Chatwoot account id
CHATWOOT_INBOX_ID=""                     # numeric inbox id tickets are created in

# ─── Instance Encryption (32-byte base64) ────────────────────────
# Encrypts secrets stored per instance. Generate with: openssl rand -base64 32
INSTANCE_ENCRYPTION_KEY=""

# ─── Bot Factory: LLM provider (OpenRouter) ──────────────────────
# Get a free key at https://openrouter.ai/keys
#
# Legacy shared key — still used by the shared-cluster bot-runtime path
# (src/lib/provisioner.ts buildBotEnv) and as a fallback for in-place
# OpenClaw instances that pre-date per-instance key minting. New OpenClaw
# VPS deploys mint their own runtime key via OPENROUTER_PROVISIONING_KEY.
OPENROUTER_API_KEY=""

# ─── Bot Factory: OpenRouter per-instance key minting ────────────
# Parent provisioning key used to mint a per-OpenClaw runtime key at
# deploy time and revoke it on delete. The parent key NEVER lands on a
# bot VM — only the child runtime key it mints does. Required for any
# new OpenClaw VPS deploys; without it provisioning fails hard rather
# than silently falling back to the shared OPENROUTER_API_KEY.
# Create at https://openrouter.ai/settings/provisioning-keys
OPENROUTER_PROVISIONING_KEY=""

# ─── Bot Factory: OpenRouter margin + real-usage billing ─────────
# Margin on OpenRouter spend. Each per-instance key is capped at
# (lifetime credits funded × this fraction) of USD, so OpenRouter can
# never bill us more than this share of revenue — a guaranteed gross
# margin of (1 - OPENROUTER_MARGIN). 0.9 = 10% margin. (0, 1]; default 0.9.
OPENROUTER_MARGIN="0.9"
# A single usage-sync interval's OpenRouter spend (USD) above this is
# treated as abuse (leaked token / runaway): disable key + pause + alert.
ANOMALY_USD_PER_INTERVAL="50"

# ─── Bot Factory: NVIDIA fallback (mid-tier) ─────────────────────
# Fallback LLM provider for mid-tier bots. Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=""
# HERMES_MODEL=""       # optional override of the default Hermes model id

# ─── Bot Factory: VPS provider router (Linode / DigitalOcean / OVH) ──
# Which provider new VMs are created on. The router scores/falls back across
# providers; this sets the default. One of: linode | digitalocean | ovh.
VM_PROVIDER="linode"
# Linode — PAT from https://cloud.linode.com/profile/tokens
#   scopes: linodes:read_write, stackscripts:read_write
LINODE_API_TOKEN=""
# LINODE_GOLDEN_IMAGE=""   # optional pre-baked image id to skip cold provisioning
# DigitalOcean — API token from https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_TOKEN=""
# OVHcloud — API credentials from https://api.ovh.com/createToken/
# OVH_ENDPOINT="ovh-eu"   # ovh-eu | ovh-ca | ovh-us  (default ovh-eu)
OVH_APP_KEY=""
OVH_APP_SECRET=""
OVH_CONSUMER_KEY=""
OVH_CLOUD_PROJECT_ID=""

# ─── Bot Factory: SSH fleet key ──────────────────────────────────
# Ed25519 keypair used to SSH into provisioned VMs. Generate with:
#   ssh-keygen -t ed25519 -f ./sovereign_fleet -N ""
# (then delete the local files — they live in env only)
SSH_FLEET_PRIVATE_KEY=""
SSH_FLEET_PUBLIC_KEY=""

# ─── Bot Factory: Runtime images + version pins ──────────────────
# Docker image for the bot runtime — built+pushed by .github/workflows/bot-runtime.yml
BOT_RUNTIME_IMAGE="ghcr.io/sovereignml/sovereign-bot-runtime:latest"
# The version pins below override the runtime image tags used per runtime
# type. Leave commented to use the defaults baked into the code.
# OPENCLAW_VERSION=""
# HERMES_VERSION=""
# OPEN_WEBUI_VERSION=""
# RUNTIME_MIN_NODE=""

# ─── Bot Factory: Gateway base URL ───────────────────────────────
# Public bot gateway URL. In dev point at your dev server; in prod the real URL.
NEXT_PUBLIC_GATEWAY_BASE_URL="http://localhost:3000"

# ─── Bot Factory: Optional external orchestrator ─────────────────
# Leave unset to use the built-in SSH-based provisioner.
OPENCLAW_ORCHESTRATOR_URL=""

# ─── Bot Factory: Telegram dev tunnel (optional) ─────────────────
# Telegram requires public HTTPS for webhooks. For dev, use ngrok and put
# its public URL here so we register the webhook against a real address.
# If unset, Telegram interface binding saves the token but skips webhook setup.
TELEGRAM_DEV_PUBLIC_URL=""

# ─── Cloudflare (DNS / SSL / origin certs) ───────────────────────
# Token needs Zone:DNS:Edit + Zone:SSL:Edit on the base domain's zone only.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_BASE_DOMAIN=""
# CLOUDFLARE_FALLBACK_IP=""   # wildcard landing host IP (used by scripts/cloudflare-bootstrap.ts)
# Origin CA cert + key (PEM) installed on provisioned VMs for end-to-end TLS.
CLOUDFLARE_ORIGIN_CERT_PEM=""
CLOUDFLARE_ORIGIN_CERT_KEY=""

# ─── Billing & cron auth tokens ──────────────────────────────────
# Bearer tokens guarding the billing/usage cron endpoints. Generate random
# strings (openssl rand -hex 32) and pass them as `Authorization: Bearer ...`.
#   /api/billing/reconcile   → BILLING_CRON_TOKEN or RECONCILE_CRON_TOKEN
#   /api/billing/usage-sync  → USAGE_SYNC_CRON_TOKEN  (run ~every 10 min)
BILLING_CRON_TOKEN=""
RECONCILE_CRON_TOKEN=""
USAGE_SYNC_CRON_TOKEN=""

# ─── Advanced / dev-only (not needed for normal prod) ────────────
# These are debug flags, seed fallbacks, and one-off script inputs.
# NODE_ENV=development     # usually set automatically by the framework
KEEP_FAILED_VMS=           # keep VMs that fail provisioning, for debugging
SKIP_OPENCLAW_ONBOARD=     # skip OpenClaw onboarding during db seed
# ADMIN_EMAIL=""           # fallback admin account email   (src/db/seed.ts)
# ADMIN_PASSWORD=""        # fallback admin account password (src/db/seed.ts)
# BAKE_REGION=""           # Linode region for scripts/bake-golden-image.ts
# BAKE_PLAN=""             # Linode plan   for scripts/bake-golden-image.ts
# TEST_USER_ID=""          # user id for scripts/test-wallet-race.ts
