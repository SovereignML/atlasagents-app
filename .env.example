# ════════════════════════════════════════════════════════════════════
#  Atlas Agents — environment configuration  (THIS FILE: template — copy to .env)
# ════════════════════════════════════════════════════════════════════
#  ⚠  KEEP `.env` AND `.env.example` IN SYNC.
#
#  These two files MUST have the SAME keys, in the SAME order, under the
#  SAME section headers, with the SAME comments. The ONLY thing that may
#  differ is the VALUES:
#
#     • .env          → real secrets & live values  (git-ignored — NEVER commit)
#     • .env.example  → empty placeholders / safe non-secret defaults
#
#  When you ADD, RENAME, or REMOVE a variable, do it in BOTH files, in the
#  same place. Change structure here → mirror it there (and vice-versa).
#
#  Order: core app → auth → billing → integrations → Bot Factory
#  (LLM / VPS / runtimes) → infra → advanced/dev-only.
#
#  Vars shown COMMENTED-OUT below are optional and fall back to a built-in
#  default in code — uncomment only to override. Leaving them as bare `KEY=`
#  would override the default with an empty string, so keep them commented.
# ════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────
# Postgres connection string used by Prisma (src/db/index.ts).
# Prod tip: append &connection_limit=10&pool_timeout=30
DATABASE_URL="postgresql://sovereignml:password@localhost:5432/sovereignml?schema=public"
# POSTGRES_* are consumed by Docker Compose to initialize the DB container;
# keep them consistent with the user/password/db in DATABASE_URL above.
POSTGRES_USER=sovereignml
POSTGRES_PASSWORD=password
POSTGRES_DB=sovereignml

# ─── App / Server ────────────────────────────────────────────────
# Public base URL of this app — used for OAuth callbacks, emails, etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # prod: https://app.atlasagents.dev
PORT=3000             # port the Next.js server listens on
HOSTNAME=127.0.0.1    # interface the server binds to

# ─── White-label custom dashboard domains (optional) ─────────────
# CNAME target shown to teams connecting a custom dashboard domain.
# Defaults to the NEXT_PUBLIC_APP_URL host. See deploy/README.md §10.
# WHITELABEL_CNAME_TARGET="cname.atlasagents.dev"
# Existing tenant CNAMEs still point at cname.sovereignml.com — keep this set
# to the old target until those customers have been migrated.

# ─── NextAuth ────────────────────────────────────────────────────
# Canonical URL NextAuth uses to build OAuth callback URLs.
NEXTAUTH_URL="http://localhost:3000"          # prod: https://app.atlasagents.dev
# Session/JWT encryption secret. Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET and AUTH_SECRET are read interchangeably — keep them equal.
NEXTAUTH_SECRET=""
AUTH_SECRET=""
AUTH_TRUST_HOST=true  # trust the host header (needed behind a proxy)

# ─── Google OAuth + Drive backups ────────────────────────────────
# Same client powers Google sign-in AND per-user Google Drive backups
# (scope drive.file). In the Google Cloud console add the Drive redirect URI
# as an Authorized redirect URI and add the `.../auth/drive.file` scope.
# (NextAuth also accepts AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET as aliases.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to <NEXT_PUBLIC_APP_URL>/api/integrations/drive/callback
GOOGLE_DRIVE_REDIRECT_URI=""

# ─── X / Twitter OAuth (optional) ────────────────────────────────
# OAuth 2.0 client from https://developer.x.com/en/portal/dashboard
# (Aliases: AUTH_TWITTER_ID / AUTH_TWITTER_SECRET.)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# ─── Apple OAuth (optional) ──────────────────────────────────────
# Service ID + a JWT client secret. Generate the secret JWT with
# `npx auth add apple` or per Apple's "Creating a Client Secret" docs.
# (Aliases: AUTH_APPLE_ID / AUTH_APPLE_SECRET.)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ─── Stripe ──────────────────────────────────────────────────────
# Secret key + webhook signing secret.
#
# In PRODUCTION (NODE_ENV=production) these are REQUIRED: the server refuses to
# boot without a valid sk_ key, a whsec_ webhook secret, a non-localhost https
# NEXT_PUBLIC_APP_URL, and the cron tokens below. The dev auto-grant / auto-
# provision fallback is disabled in production — with these blank, every paid
# endpoint (top-up, deploy, BYOS) returns 503 instead of granting for free.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs per plan tier — names MUST match src/configs/plans.ts
# (FREE, LITE, BUILDER, OPERATOR, SCALE, ENTERPRISE, BYOS).
STRIPE_PRICE_FREE_MONTHLY=""
STRIPE_PRICE_FREE_YEARLY=""
STRIPE_PRICE_LITE_MONTHLY=""
STRIPE_PRICE_LITE_YEARLY=""
STRIPE_PRICE_BUILDER_MONTHLY=""
STRIPE_PRICE_BUILDER_YEARLY=""
STRIPE_PRICE_OPERATOR_MONTHLY=""
STRIPE_PRICE_OPERATOR_YEARLY=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_YEARLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_YEARLY=""
STRIPE_PRICE_BYOS_MONTHLY=""
STRIPE_PRICE_BYOS_YEARLY=""
# Separate webhook secret for Stripe Connect (reseller / connected-account
# events). Only needed if you use reseller billing. Distinct from
# STRIPE_WEBHOOK_SECRET above. (src/app/api/webhooks/stripe-connect/route.ts)
STRIPE_CONNECT_WEBHOOK_SECRET=""

# ─── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@atlasagents.dev"

# ─── Notifications: Telegram bot ─────────────────────────────────
# A DEDICATED bot for sending users their notifications. This is NOT a
# user's deployed bot (those route at /tg/[botToken]). Create one via
# @BotFather, then register the webhook once:
#   curl "https://api.telegram.org/bot<token>/setWebhook" \
#     -d url=<NEXT_PUBLIC_APP_URL>/api/notifications/telegram/webhook \
#     -d secret_token=<NOTIFY_TELEGRAM_WEBHOOK_SECRET>
# Discord/Slack need no env — users paste per-account incoming webhook URLs.
NOTIFY_TELEGRAM_BOT_TOKEN=""            # from @BotFather
NOTIFY_TELEGRAM_BOT_USERNAME=""         # bot username for the t.me deep link, no @
NOTIFY_TELEGRAM_WEBHOOK_SECRET=""       # verifies X-Telegram-Bot-Api-Secret-Token

# ─── Chatwoot Support ────────────────────────────────────────────
# Live-chat widget + in-app support tickets, backed by your Chatwoot
# instance. The two NEXT_PUBLIC_ vars power the embedded chat bubble;
# the rest are server-only and used to create tickets via the API.
#
# Tickets are created in CHATWOOT_INBOX_ID — must be an API inbox
# (Channel::Api), not the website-widget inbox: Chatwoot rejects incoming
# messages posted via API token into widget inboxes. If the API vars are
# unset (or a call fails) the ticket form falls back to emailing support@.
NEXT_PUBLIC_CHATWOOT_BASE_URL=""  # e.g. https://chat.atlasagents.dev (no trailing slash)
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=""    # website channel token (public, drives the widget)
CHATWOOT_HMAC_TOKEN=""                   # optional — enables widget identity verification
CHATWOOT_API_ACCESS_TOKEN=""            # agent/bot API access token (server only)
CHATWOOT_ACCOUNT_ID=""                   # numeric Chatwoot account id
CHATWOOT_INBOX_ID=""                     # numeric inbox id tickets are created in

# ─── Instance Encryption (32-byte base64) ────────────────────────
# Encrypts secrets stored per instance. Generate with: openssl rand -base64 32
INSTANCE_ENCRYPTION_KEY=""

# ─── Bot Factory: LLM provider (OpenRouter) ──────────────────────
# Get a free key at https://openrouter.ai/keys
#
# Legacy shared key — still used by the shared-cluster bot-runtime path
# (src/lib/provisioner.ts buildBotEnv) and as a fallback for in-place
# OpenClaw instances that pre-date per-instance key minting. New OpenClaw
# VPS deploys mint their own runtime key via OPENROUTER_PROVISIONING_KEY.
OPENROUTER_API_KEY=""

# ─── Bot Factory: OpenRouter per-instance key minting ────────────
# Parent provisioning key used to mint a per-OpenClaw runtime key at
# deploy time and revoke it on delete. The parent key NEVER lands on a
# bot VM — only the child runtime key it mints does. Required for any
# new OpenClaw VPS deploys; without it provisioning fails hard rather
# than silently falling back to the shared OPENROUTER_API_KEY.
# Create at https://openrouter.ai/settings/provisioning-keys
OPENROUTER_PROVISIONING_KEY=""

# ─── Bot Factory: OpenRouter margin + real-usage billing ─────────
# Margin on OpenRouter spend. Each per-instance key is capped at
# (lifetime credits funded × this fraction) of USD, so OpenRouter can
# never bill us more than this share of revenue — a guaranteed gross
# margin of (1 - OPENROUTER_MARGIN). 0.9 = 10% margin. (0, 1]; default 0.9.
OPENROUTER_MARGIN="0.9"
# A single usage-sync interval's OpenRouter spend (USD) above this is
# treated as abuse (leaked token / runaway): disable key + pause + alert.
ANOMALY_USD_PER_INTERVAL="50"

# ─── Bot Factory: NVIDIA fallback provider ───────────────────────
# Direct OpenAI-compatible fallback to OpenRouter (https://integrate.api.nvidia.com/v1).
# Get keys at https://build.nvidia.com/. Either key reaches the full catalog; two
# just spreads load over two free-tier pools.
# Legacy single key — back-compat fallback used when the slot keys below are unset.
NVIDIA_API_KEY=""
# Per-slot keys for the admin Models panel and per-model routing.
# PRIMARY pairs with mistralai/mistral-medium-3.5-128b, SECONDARY with z-ai/glm-5.1.
NVIDIA_API_KEY_PRIMARY=""
NVIDIA_API_KEY_SECONDARY=""

# Platform-wide default LLM provider: "openrouter" (default) or "nvidia". Set to
# "nvidia" to provision bots directly against NVIDIA — the platform then runs with
# zero OpenRouter dependency (works without OpenRouter credits). Can be overridden
# per instance via the instances.llmProvider column.
LLM_DEFAULT_PROVIDER="openrouter"
# HERMES_MODEL=""       # optional override of the default Hermes model id
# CLAUDE_CODE_MODEL=""  # optional override of every Claude Code tier (an anthropic/ slug)
# CODEX_MODEL=""        # optional override of every Codex tier (an openai/ slug)

# ─── Bot Factory: Beta runtimes (Claude Code, Codex) ─────────────
# Off by default: only platform admins can deploy them. "true" offers them to
# every customer (paid plans only). See docs/RUNTIMES.md § Claude Code & Codex.
# CLI_RUNTIMES_ENABLED="false"
# Codex's wire protocol to OpenRouter: "responses" (default) or "chat".
# CODEX_WIRE_API="responses"

# ─── Bot Factory: VPS provider router (DigitalOcean / Linode) ──
# Which provider new VMs are created on. The router scores/falls back across
# enabled providers; this sets the default used by legacy/fallback paths only.
# One of: digitalocean | linode. Akamai (Linode) is the PRIMARY provider (warm
# pool is Linode Frankfurt); DigitalOcean is failover.
VM_PROVIDER="linode"
# DigitalOcean (primary) — API token from
#   https://cloud.digitalocean.com/account/api/tokens  (scope: write)
# DO has no root-password API: access is via the SSH fleet key below, which the
# adapter auto-registers as "sovereign-fleet".
DIGITALOCEAN_API_TOKEN=""
# Linode / Akamai (failover) — PAT from https://cloud.linode.com/profile/tokens
#   scopes: linodes:read_write, stackscripts:read_write
LINODE_API_TOKEN=""
# LINODE_GOLDEN_IMAGE=""   # optional pre-baked image id to skip cold provisioning

# ─── Bot Factory: SSH fleet key ──────────────────────────────────
# Ed25519 keypair used to SSH into provisioned VMs. Generate with:
#   ssh-keygen -t ed25519 -f ./sovereign_fleet -N ""
# (then delete the local files — they live in env only)
SSH_FLEET_PRIVATE_KEY=""
SSH_FLEET_PUBLIC_KEY=""

# ─── Bot Factory: Runtime images + version pins ──────────────────
# Docker image for the bot runtime — built+pushed by .github/workflows/bot-runtime.yml
BOT_RUNTIME_IMAGE="ghcr.io/sovereignml/sovereign-bot-runtime:latest"
# What new agent boxes install. Leave these commented to use the versions
# pinned in code (OPENCLAW_PINNED_VERSION in src/lib/runtimes/openclaw.ts,
# OPEN_WEBUI_PINNED_VERSION in src/lib/runtimes/open-webui.ts,
# HERMES_PINNED_VERSION in src/lib/runtimes/hermes.ts, the CLAUDE_* pins in
# src/lib/runtimes/claude-code.ts, the CODEX_* pins in src/lib/runtimes/codex.ts,
# CADDY_DEFAULT_VERSION in src/lib/runtimes/bootstrap.ts). Set one to roll a
# bad release back (or forward) without a code deploy; "latest" tracks
# upstream again. Changing one retires the warm pool's VMs automatically.
# OPENCLAW_VERSION=""
# HERMES_VERSION=""
# OPEN_WEBUI_VERSION=""
# ATLAS_CLAUDE_CODE_VERSION=""       # NOT CLAUDE_CODE_VERSION: Claude Code exports that itself
# ATLAS_CLAUDE_AGENT_SDK_VERSION=""
# CODEX_VERSION=""
# CODEX_SDK_VERSION=""
# CADDY_VERSION=""
# RUNTIME_MIN_NODE=""

# ─── Bot Factory: Gateway base URL ───────────────────────────────
# Public bot gateway URL. In dev point at your dev server; in prod the real URL.
NEXT_PUBLIC_GATEWAY_BASE_URL="http://localhost:3000"

# ─── Bot Factory: Optional external orchestrator ─────────────────
# Leave unset to use the built-in SSH-based provisioner.
OPENCLAW_ORCHESTRATOR_URL=""

# ─── Bot Factory: Telegram dev tunnel (optional) ─────────────────
# Telegram requires public HTTPS for webhooks. For dev, use ngrok and put
# its public URL here so we register the webhook against a real address.
# If unset, Telegram interface binding saves the token but skips webhook setup.
TELEGRAM_DEV_PUBLIC_URL=""

# ─── Cloudflare (DNS / SSL / origin certs) ───────────────────────
# Token needs Zone:DNS:Edit + Zone:SSL:Edit on every agent zone below.
CLOUDFLARE_API_TOKEN=""
# The LEGACY agent zone (sovereignclaw.xyz): where every agent created so far
# lives. Keep these as they are after a zone move — those agents' DNS records
# and origin certs stay in this zone. CLOUDFLARE_ZONE_ID is also the fallback
# for CLOUDFLARE_SAAS_ZONE_ID. (src/lib/agent-zones.ts)
CLOUDFLARE_ZONE_ID=""
# SaaS-enabled zone for white-label custom hostnames (Cloudflare for SaaS).
# Falls back to CLOUDFLARE_ZONE_ID if unset. (src/lib/cloudflare-saas.ts)
CLOUDFLARE_SAAS_ZONE_ID=""
# Defaults to sovereignclaw.xyz.
CLOUDFLARE_BASE_DOMAIN=""
# CLOUDFLARE_FALLBACK_IP=""   # wildcard landing host IP (used by scripts/cloudflare-bootstrap.ts)
# Origin CA cert + key (PEM) for *.<legacy zone>, installed on each box over
# SSH when an agent is configured, so the zone can run in Full (strict).
CLOUDFLARE_ORIGIN_CERT_PEM=""
CLOUDFLARE_ORIGIN_CERT_KEY=""
# The NEW agent zone. Once domain + zone id are both set, new agents get
# <name>.<CLOUDFLARE_AGENT_DOMAIN>; existing agents keep their hostnames.
# Unset = everything stays in the legacy zone. Verify with
# `node --env-file=.env --import tsx scripts/check-agent-zones.ts`.
# Cutover runbook: docs/REBRAND-LEGACY-IDENTIFIERS.md.
# CLOUDFLARE_AGENT_DOMAIN=""          # e.g. atlasagents.xyz
# CLOUDFLARE_AGENT_ZONE_ID=""
# CLOUDFLARE_AGENT_ORIGIN_CERT_PEM="" # Origin CA cert for *.<agent domain>
# CLOUDFLARE_AGENT_ORIGIN_CERT_KEY=""

# ─── Cloudflare Turnstile (bot protection on auth forms) ─────────
# Anti-bot challenge on the register / login / forgot-password forms. Get keys
# at https://dash.cloudflare.com/?to=/:account/turnstile. Leave BOTH unset to
# disable Turnstile entirely (dev/local) — both must be set to enable it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Sentry error monitoring (optional but recommended in prod) ──
# Create a Next.js project at https://sentry.io. Leave DSNs unset to disable
# Sentry entirely (dev/local). SENTRY_DSN covers the server; the NEXT_PUBLIC
# one covers browser + edge (middleware). AUTH_TOKEN/ORG/PROJECT are only
# needed at build time to upload source maps — safe to omit.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ─── PostHog product analytics (optional) ────────────────────────
# Create a project at https://us.posthog.com. Leave NEXT_PUBLIC_POSTHOG_KEY
# unset to disable PostHog entirely (dev/local). When set, client analytics,
# session replay, and feature flags activate; browser events are proxied
# through the app at /ingest (next.config.ts rewrites) so ad-blockers don't
# drop them. The key is inlined at BUILD time — set it in the build env too.
# (src/components/posthog-provider.tsx, src/lib/posthog-server.ts)
NEXT_PUBLIC_POSTHOG_KEY=""          # phc_... project API key
NEXT_PUBLIC_POSTHOG_HOST="/ingest"  # reverse-proxy path; only change if self-hosting PostHog
POSTHOG_KEY=""                      # server SDK key (optional; falls back to NEXT_PUBLIC_POSTHOG_KEY)
POSTHOG_HOST="https://us.i.posthog.com"  # server SDK talks direct — no proxy needed server-side

# ─── Ad-conversion tracking: Meta + Google (optional) ────────────
# Server-side conversion tracking for ad attribution. Unblockable (no browser
# pixel) — events are sent server-to-server on signup and on Stripe purchase.
# Each platform is independent and a no-op until its vars are set. Nothing is
# transmitted unless the user grants marketing consent (see the consent banner).
# (src/lib/ads/*, docs/AD-CONVERSIONS.md)
#
# Meta Conversions API — Events Manager → Settings → Conversions API.
META_PIXEL_ID=""                     # numeric pixel (dataset) id
META_CAPI_ACCESS_TOKEN=""            # system-user token for the pixel
META_GRAPH_API_VERSION="v21.0"       # optional; pin the Graph API version
META_CAPI_TEST_EVENT_CODE=""         # optional; routes to Test Events while validating
#
# Google Ads via the Data Manager API (NOT the deprecated UploadClickConversions).
# Auth is a service account with the datamanager scope, linked in Google Ads.
# Provide the key JSON inline (raw or base64). Each conversion action is a
# separate "destination" id — set the ones you use.
GOOGLE_DM_SERVICE_ACCOUNT_JSON=""    # service-account key JSON (raw or base64)
GOOGLE_ADS_CUSTOMER_ID=""            # operating account, digits only (no dashes)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""      # optional; manager (MCC) id if auth goes through one
GOOGLE_DM_SIGNUP_DESTINATION_ID=""   # destination/conversion-action id for signups
GOOGLE_DM_PURCHASE_DESTINATION_ID="" # destination/conversion-action id for purchases

# ─── Uptime monitoring (Uptime Kuma) ─────────────────────────────
# Per-instance uptime monitors, backed by your Uptime Kuma instance.
# BASE_URL + API_KEY enable read-only /metrics scraping; USERNAME/PASSWORD
# enable Socket.io writes (create/edit/delete monitors — the admin account
# used must NOT have 2FA enabled). Leave all unset to disable the feature.
# (src/lib/uptime-kuma.ts)
UPTIME_KUMA_BASE_URL=""        # e.g. https://uptime.atlasagents.dev (no trailing slash)
UPTIME_KUMA_USERNAME=""        # service account for Socket.io writes
UPTIME_KUMA_PASSWORD=""        # paired with username
UPTIME_KUMA_API_KEY=""         # HTTP Basic password for the /metrics scrape
# UPTIME_KUMA_INSECURE_TLS=    # set true to allow self-signed TLS on the Kuma host

# ─── Cron & job auth tokens ──────────────────────────────────────
# Bearer tokens guarding the cron/job endpoints. Generate random strings
# (openssl rand -hex 32) and pass them as `Authorization: Bearer ...`.
#   /api/billing/reconcile    → BILLING_CRON_TOKEN or RECONCILE_CRON_TOKEN
#   /api/billing/daily        → BILLING_CRON_TOKEN          (daily compute billing; cron-tick.sh runs it only when DAILY_BILLING_ENABLED=true)
#   /api/billing/usage-sync   → USAGE_SYNC_CRON_TOKEN       (run ~every 10 min)
#   /api/billing/expire-credits → CREDIT_EXPIRY_CRON_TOKEN  (daily: drip monthly credits to yearly subs + expire use-it-or-lose-it plan credits)
#   /api/admin/backups/cron   → BACKUP_CRON_TOKEN           (nightly DB backup → R2)
#   /api/internal/uptime-sync → UPTIME_SYNC_CRON_TOKEN      (scrape Kuma → DB)
#   /api/internal/metrics-collect → METRICS_COLLECT_CRON_TOKEN (SSH-probe server RAM/CPU/OS/health → DB; run ~every 1–2 min)
#   /api/internal/demo-reap   → DEMO_REAP_CRON_TOKEN        (tear down expired Free demos; run ~every 1 min)
#   /api/internal/pool-refill → POOL_REFILL_CRON_TOKEN      (OPTIONAL: pool self-refills in-process at boot; this is a manual admin trigger / extra backstop only)
#   /api/audit-log/prune      → AUDIT_RETENTION_CRON_TOKEN  (prune old audit logs)
#   /api/internal/alerts-eval → ALERTS_EVAL_CRON_TOKEN      (evaluate alert rules; run ~every 5–10 min)
#   /api/internal/events-prune → EVENTS_RETENTION_CRON_TOKEN (prune old agent events; daily)
#   /api/admin/notifications/prune → ADMIN_NOTIFICATION_RETENTION_CRON_TOKEN (prune resolved admin notifications; daily)
BILLING_CRON_TOKEN=""
RECONCILE_CRON_TOKEN=""
USAGE_SYNC_CRON_TOKEN=""
CREDIT_EXPIRY_CRON_TOKEN=""
BACKUP_CRON_TOKEN=""
UPTIME_SYNC_CRON_TOKEN=""
METRICS_COLLECT_CRON_TOKEN=""
DEMO_REAP_CRON_TOKEN=""
AUDIT_RETENTION_CRON_TOKEN=""
ALERTS_EVAL_CRON_TOKEN=""
EVENTS_RETENTION_CRON_TOKEN=""
ADMIN_NOTIFICATION_RETENTION_CRON_TOKEN=""
POOL_REFILL_CRON_TOKEN=""
# scripts/cron-tick.sh schedules daily compute billing (03:30 UTC) only when
# this is true. It charges every running managed agent a day of its server
# price and pauses agents whose wallet can't cover it, so it is opt-in.
DAILY_BILLING_ENABLED=""

# ── Warm VM pool ─────────────────────────────────────────────────────────────
# Pre-booted, fully-bootstrapped, pre-URL'd VMs kept ready so a deploy can CLAIM
# one and skip the multi-minute cold install (sub-25s delivery). This is now the
# PRIMARY delivery path for managed VPS deploys (cold provisioning only runs as a
# fallback when the pool is momentarily dry), so it is ON BY DEFAULT (opt-out)
# whenever the infra creds are present — a provider token + SSH_FLEET_PRIVATE_KEY
# (same as live provisioning). Without those creds it stays off automatically, so
# dev never spins up billable VMs by accident. See docs/DEPLOYMENT.md.
# Idle VMs bill continuously (~$120/mo for the default 3 Hermes + 2 OpenClaw at a
# 4GB VPS class). Set to "false" to disable the pool entirely.
#
# The pool SELF-REFILLS from an in-process scheduler started at server boot — no
# external cron is required. POOL_REFILL_INTERVAL_MS tunes the tick (default
# 60000). The /api/internal/pool-refill endpoint is only an optional manual /
# admin backstop.
POOL_ENABLED=""
POOL_SIZE_HERMES="2"
POOL_SIZE_OPENCLAW="1"
# POOL_REFILL_INTERVAL_MS="60000"   # in-process refill cadence (ms); default 60000
# Provider/plan/region the pool warms — MUST match the plan/region deploys route
# to, or claims miss and fall back to the cold path. Linode Frankfurt is the
# baseline box for every managed deploy (Linode is the primary provider).
POOL_PROVIDER_SLUG="linode"
POOL_PLAN_CODE="g6-standard-2"
POOL_REGION_CODE="eu-central"
# EVENTS_RETENTION_DAYS="30"   # how long AgentEvent rows are kept before events-prune deletes them

# ─── Billing tuning (optional overrides) ─────────────────────────
# Reconciliation + low-balance thresholds. Leave commented to use defaults.
# BILLING_DRIFT_USD="1"              # USD gap vs OpenRouter spend before flagging drift
# BILLING_RECONCILE_MAX_KEYS="250"   # max OpenRouter key polls per reconcile run
# LOW_BALANCE_WARN_MULTIPLIER="2"    # warn at this × the wallet minimum balance

# ─── Admin database backups (Cloudflare R2) ──────────────────────
# The R2 credentials themselves are entered in the admin UI (/admin/backups)
# and stored ENCRYPTED in the database — they are NOT env vars. The only
# server-side requirement is a postgresql-client (`pg_dump`/`pg_restore`)
# binary whose major version is >= the Postgres server version. If those
# binaries are not on PATH, point at them explicitly:
# PG_DUMP_PATH=""           # absolute path to pg_dump    (default: "pg_dump")
# PG_RESTORE_PATH=""        # absolute path to pg_restore (default: "pg_restore")

# ─── Advanced / dev-only (not needed for normal prod) ────────────
# These are debug flags, seed fallbacks, and one-off script inputs.
# NODE_ENV=development     # usually set automatically by the framework
KEEP_FAILED_VMS=           # keep VMs that fail provisioning, for debugging
SKIP_OPENCLAW_ONBOARD=     # skip OpenClaw onboarding during db seed
# BYOS_HOST_ALLOWLIST=     # comma-sep hosts allowed past the SSRF guard (BYOS SSH targets)
# First admin account (src/db/seed.ts + scripts/make-admin.ts).
# Default email: admin@sovereignml.com. In production the seed REFUSES to
# create the admin unless ADMIN_PASSWORD is set explicitly (no weak default);
# alternatively run `npm run make-admin` for an interactive password prompt.
# ADMIN_EMAIL=""           # first admin account email
# ADMIN_PASSWORD=""        # first admin account password (set your own!)
# BAKE_REGION=""           # Linode region for scripts/bake-golden-image.ts
# BAKE_PLAN=""             # Linode plan   for scripts/bake-golden-image.ts
# TEST_USER_ID=""          # user id for scripts/test-wallet-race.ts
